# Database (SQLite file, local dev / demo). Point this at Postgres in production.
DATABASE_URL="file:./dev.db"

# Stripe — get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs — create one Price per package in the Stripe dashboard
# (Product catalog) and paste the IDs here. Checkout falls back to a
# server-generated ad-hoc price if a given package has no Price ID set,
# so the flow works end to end before Stripe is fully configured.
STRIPE_PRICE_IDEA_CHECK=""
STRIPE_PRICE_MARKET_TEST=""
STRIPE_PRICE_VALIDATION_SPRINT=""
STRIPE_PRICE_PRESALE_SPRINT=""

# Custom PHP checkout (see /checkout). Set this and every "Get started" button
# sends the buyer to that app instead of a hosted Stripe Checkout Session.
# Leave it empty to keep using /api/checkout.
NEXT_PUBLIC_CHECKOUT_URL=""

# PostHog — get keys from https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Admin notifications (new contact submission, new paid signup) — see
# src/lib/notify.ts. Logs to console instead of sending until RESEND_API_KEY
# is set; get a key from https://resend.com/api-keys and a "from" address on
# a domain you've verified there.
CONTACT_NOTIFICATION_EMAIL="hello@kpindicator.co"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Outbound marketing email tracking — see docs/email-campaigns.md.
# No ESP is wired up yet (sending settings pending). Once one is chosen,
# point its webhook at /api/webhooks/email and set this to a random string
# to authenticate those requests (leave blank while testing locally).
EMAIL_WEBHOOK_SECRET=""

# Base URL, used for Stripe redirect URLs and canonical links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
