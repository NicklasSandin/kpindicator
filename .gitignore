# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the templates. Without these, .env.example is ignored too, and the
# documented configuration never reaches anyone who clones the repo.
!.env.example
!**/.env.example

# MCP config holds live credentials (DB password, GitHub PAT, Stripe key) — see .mcp.json.example
/.mcp.json

# vercel
.vercel

# database
/prisma/dev.db
/prisma/dev.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts
