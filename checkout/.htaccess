# Defence in depth: checkout/public is the document root, so nothing here should
# ever be reachable over HTTP. This only matters if someone points the docroot
# at the repository instead — in which case .env, src/ and views/ stay closed.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
