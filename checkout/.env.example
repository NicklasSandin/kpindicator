# KPIndicator custom checkout (PHP) — copy this to checkout/.env
#
# Resolution order is: real process environment, then checkout/.env, then the
# repo-root .env, then STRIPE_ENV_FILE if set. First one to define a key wins,
# so anything the Next.js app already has configured works here untouched and
# only the differences belong in this file.

# --- Stripe connection -------------------------------------------------------
# Share another app's Stripe connection instead of copying its secret key.
# Pointed at BrandSentryPro's .env, both apps charge the same Stripe account
# from one file: rotate the key there and this checkout follows. Read last, so
# anything set below still overrides it.
#STRIPE_ENV_FILE="/var/www/backend1.brandsentrypro.com/.env"

# Or set the keys directly. STRIPE_KEY is accepted as an alias for
# STRIPE_SECRET_KEY — that is the name BrandSentryPro uses.
STRIPE_SECRET_KEY=""

# Not derivable from the secret key: copy it from
# Stripe dashboard > Developers > API keys. Must be from the same account.
STRIPE_PUBLISHABLE_KEY=""

# Stripe dashboard > Developers > Webhooks > your endpoint > signing secret.
# Without it POST /webhook returns 501 and only the return page records orders.
STRIPE_WEBHOOK_SECRET=""

# Pinned API version. Matches the one BrandSentryPro pins for Elements.
#STRIPE_API_VERSION="2026-03-25.dahlia"
#STRIPE_WEBHOOK_TOLERANCE="300"

# --- Prices ------------------------------------------------------------------
# Optional. With a Price ID set, the amount and currency come from Stripe, so a
# price change in the dashboard needs no deploy. Left empty, the checkout
# charges the catalog amount in checkout/src/Packages.php.
#STRIPE_PRICE_IDEA_CHECK=""
#STRIPE_PRICE_MARKET_TEST=""
#STRIPE_PRICE_VALIDATION_SPRINT=""
#STRIPE_PRICE_PRESALE_SPRINT=""

# --- This app ----------------------------------------------------------------
# "production" silences the live-key warning bar. Leave it as development
# locally so a live key is impossible to miss.
CHECKOUT_ENV="development"

# Public base URL of this checkout, used to build Stripe's return_url. Required
# behind a proxy or on a subpath; derived from the request when unset.
#CHECKOUT_BASE_URL="https://checkout.kpindicator.com"

# Marketing site to link back to. Falls back to NEXT_PUBLIC_SITE_URL.
#CHECKOUT_SITE_URL="https://kpindicator.com"

# Shown to buyers when something goes wrong. Falls back to CONTACT_NOTIFICATION_EMAIL.
#CHECKOUT_SUPPORT_EMAIL="hello@kpindicator.com"

# --- Order recording ---------------------------------------------------------
# Inherited from the repo-root .env. PostgreSQL only, and ext-pdo_pgsql must be
# installed; anything else logs and skips recording rather than failing a charge.
#DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Notifications -----------------------------------------------------------
# Same keys as src/lib/notify.ts. Unset, alerts go to the PHP error log.
#RESEND_API_KEY=""
#RESEND_FROM_EMAIL=""
#CONTACT_NOTIFICATION_EMAIL=""
